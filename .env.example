NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
SEED_DEV_DATA=true

# Local SQLite fallback
SQLITE_DB_PATH=database/ecobi-dev.sqlite

# PostgreSQL / Cloud SQL
# DB_CLIENT=postgres
# DATABASE_URL=postgresql://ecobi_user:password@localhost:5432/ecobi-2
# For Cloud SQL Unix socket, either use DATABASE_URL with ?host=/cloudsql/PROJECT:REGION:INSTANCE
# or split credentials:
# DB_HOST=/cloudsql/PROJECT:REGION:INSTANCE
# DB_PORT=5432
# DB_NAME=ecobi-2
# DB_USER=ecobi_user
# DB_PASSWORD=replace-me
# DB_POOL_MAX=5
# DATABASE_SSL=false

# ML recommender adapter
# RECOMMENDATION_ADAPTER=ml
# ML_RECOMMENDER_ENABLED=true
# ML_PYTHON_PATH=/opt/venv/bin/python
# ML_RECOMMENDER_TIMEOUT_MS=60000
# ML_RECOMMENDER_SKIP_MODELS=false
# CLOUD_SQL_INSTANCE_CONNECTION_NAME=PROJECT:REGION:INSTANCE
# CLOUD_SQL_IP_TYPE=PUBLIC

VITE_API_BASE_URL=/api/v1
